### ----------------------------------------------------
### 🔧 CONFIG
### ----------------------------------------------------
@host = http://localhost:3000
@contentType = application/json

@email = "lucas@test.com"
@password = "123456"

### ----------------------------------------------------
### 👤 1. SIGNUP  (registro usuario)
### ----------------------------------------------------
POST {{host}}/api/user/signup
Content-Type: {{contentType}}

{
  "email": {{email}},
  "password": {{password}}
}

### ----------------------------------------------------
### 🔐 2. LOGIN  (obtener token JWT)
### ----------------------------------------------------
# @name login
POST {{host}}/api/user/login
Content-Type: {{contentType}}

{
  "email": {{email}},
  "password": {{password}}
}

### Guardamos el token:
@token = {{login.response.body.token}}

### ----------------------------------------------------
### 🔒 3. TEST TOKEN (endpoint protegido)
### ----------------------------------------------------
GET {{host}}/api/v1/products
Authorization: Bearer {{token}}
Accept: application/json

### ----------------------------------------------------
### 📦 4. CREAR PRODUCTO (ADMIN REQUIRED)
### ----------------------------------------------------
POST {{host}}/api/v1/products
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "nombre": "Zapatilla Runner Ultra",
  "precio": 35000
}

### ----------------------------------------------------
### 📦 5. OBTENER TODOS LOS PRODUCTOS
### ----------------------------------------------------
GET {{host}}/api/v1/products
Authorization: Bearer {{token}}
Accept: application/json

### ----------------------------------------------------
### 📦 6. OBTENER PRODUCTO POR ID
### Guarda un ID manualmente después de ejecutar GET anterior
### ----------------------------------------------------
@productId = REEMPLAZAR_ID

GET {{host}}/api/v1/products/{{productId}}
Authorization: Bearer {{token}}
Accept: application/json

### ----------------------------------------------------
### ✏️ 7. EDITAR PRODUCTO (ADMIN)
### ----------------------------------------------------
PUT {{host}}/api/v1/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "nombre": "Zapatilla Runner Ultra X",
  "precio": 36000
}

### ----------------------------------------------------
### 🗑️ 8. ELIMINAR PRODUCTO (ADMIN)
### ----------------------------------------------------
DELETE {{host}}/api/v1/products/{{productId}}
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 📊 9. ESTADÍSTICAS DE PRODUCTOS
### ----------------------------------------------------
GET {{host}}/api/v1/products/stats
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 👥 10. GET USERS (ADMIN ONLY)
### ----------------------------------------------------
GET {{host}}/api/user
Authorization: Bearer {{token}}
